{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/vehicules.php", "destination": "/api/vehicules" },
    { "source": "/envoi-devis.php", "destination": "/api/envoi-devis" },
    { "source": "/envoi-recherche.php", "destination": "/api/envoi-recherche" },
    { "source": "/assets/img/logo-achetez-easy.png", "destination": "/api/img?f=logo" },
    { "source": "/assets/img/logo-achetez-easy-clair.png", "destination": "/api/img?f=logo-clair" },
    { "source": "/assets/img/logo-achetez-easy-carre.png", "destination": "/api/img?f=logo" },
    { "source": "/assets/img/portrait-kilyan.jpg", "destination": "https://achetezeasy.fr/portrait-kilyan.jpg" },
    { "source": "/assets/img/portrait-lauralee.jpg", "destination": "https://achetezeasy.fr/portrait-lauralee.jpg" },
    { "source": "/assets/img/portrait-ernesto.jpg", "destination": "https://achetezeasy.fr/portrait-ernesto.jpg" },
    { "source": "/assets/img/portrait-keyne.jpg", "destination": "https://achetezeasy.fr/portrait-keyne.jpg" },
    { "source": "/partage-achetez-easy.jpg", "destination": "https://achetezeasy.fr/partage-achetez-easy.jpg" },
    { "source": "/photos.php", "destination": "https://achetezeasy.fr/photos.php" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; font-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; require-trusted-types-for 'script'; trusted-types 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), serial=(), browsing-topics=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
